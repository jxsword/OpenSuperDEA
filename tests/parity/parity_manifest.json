        "orientation": "in",
        "rts": "crs"
      },
      "reference": {
        "tool": "deaR",
        "script": "refimpl/deaR_radial.R",
        "args": [
          "crs",
          "io"
        ]
      },
      "compare": {
        "score": "efficiency"
      }
    },
