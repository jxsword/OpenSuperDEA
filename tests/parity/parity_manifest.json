{
  "schema": "opensuperdea-parity-manifest/1",
  "notes": "M2 分支 1 最小批：径向族 8 组合（toy_cross）。列映射 product→reference；容差覆写缺省取顶层双阈值（P-010）。分支 2/3 增量追加 SBM/加性/DDF/交叉/窗口/Malmquist 批。",
  "cli": {
    "binary": "build/src/opensuperdea",
    "format": "json"
  },
  "tolerance": {
    "abs": 1e-06,
    "rel": 1e-09
  },
